TILEBOX_API_KEY=your-api-key
TILEBOX_CLUSTER=
CDSE_ACCESS_KEY=your-s3-access-key
CDSE_SECRET_KEY=your-s3-secret-key
# Storage-event mode: append Pulumi's workerEnvironment output to .env.
# AZURE_STORAGE_ACCOUNT=your-storage-account
# AZURE_STORAGE_CONTAINER=scenes
# AZURE_PREVIEW_CONTAINER=previews
# Pulumi creates these worker credentials:
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret
